{
  "name": "master-vision",
  "version": "1.2.1",
  "description": "A private visual library desktop app",
  "productName": "Mosaic",
  "main": "main.js",
  "scripts": {
    "build:ui": "npm --prefix ui run build",
    "prestart": "npm run build:ui",
    "start": "electron .",
    "dev": "electron .",
    "package:extension": "node scripts/package-extension.cjs",
    "dist:win": "npm run build:ui && npm run package:extension && electron-builder --win nsis --x64 && node scripts/organize-release.cjs"
  },
  "devDependencies": {
    "electron": "^32.2.7",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "exiftool-vendored": "^33.0.0",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "com.danhtran.mosaic",
    "productName": "Mosaic",
    "artifactName": "Mosaic-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "extension/native-host.js",
      "package.json",
      "ui/dist/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!.tmp-video-thumb-test/**",
      "!release/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/exiftool-vendored.exe/**",
      "node_modules/exiftool-vendored.pl/**",
      "assets/mosaic-exif.config"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "uninstallDisplayName": "Mosaic",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "danhtran172",
      "repo": "Mosaic",
      "releaseType": "release"
    }
  }
}
