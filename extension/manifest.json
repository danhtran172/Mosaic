{
  "manifest_version": 3,
  "key": "",
  "name": "InDeck Extention",
  "version": "1.0.0",
  "description": "Save web images to InDeck.",
  "permissions": ["contextMenus", "notifications", "clipboardWrite", "offscreen", "storage", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "InDeck Extention" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
