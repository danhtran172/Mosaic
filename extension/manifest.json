{
  "manifest_version": 3,
  "key": "",
  "name": "Mosaic Extension",
  "version": "1.2.0",
  "description": "Save web images to Mosaic.",
  "permissions": ["contextMenus", "notifications", "clipboardWrite", "offscreen", "storage", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "icons": { "16": "icons/mosaic.png", "32": "icons/mosaic.png", "48": "icons/mosaic.png", "128": "icons/mosaic.png" },
  "action": { "default_title": "Mosaic Extension", "default_icon": { "16": "icons/mosaic.png", "32": "icons/mosaic.png", "48": "icons/mosaic.png", "128": "icons/mosaic.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
